# Copy to /etc/tn-assistant/tn-assistant.env and fill secrets on the server.
TN_ADDR=127.0.0.1:8094
TN_RUNTIME_MODE=independent
TN_DB=/var/lib/tn-assistant/tn-assistant.sqlite
TN_PUBLIC_URL=https://assistant.tnfastvn.com
TN_STATIC_DIR=/www/wwwroot/tn.assistant
TN_DOWNLOAD_DIR=/var/lib/tn-assistant/downloads
TN_ADMIN_USER=admin
TN_PROVIDER_FILE=/etc/tn-assistant/providers.json
# Generate a unique value on the server; never commit or log it.
TN_WEBHOOK_SECRET=
# Temporarily set TN_ADMIN_PASSWORD for first initialization, then remove it.
# Set TN_ZALO_APP_SECRET only after rotating the Zalo app secret.

# Zalo-only mTLS egress; enable only after deploying an authorized gateway.
# The backend still validates Zalo's public TLS certificate inside the tunnel.
# TN_ZALO_EGRESS_MODE=gateway
# TN_ZALO_GATEWAY_ADDR=zalo-gateway.tnfastvn.com:443
# TN_ZALO_GATEWAY_SERVER_NAME=zalo-gateway.tnfastvn.com
# TN_ZALO_GATEWAY_CA_FILE=/etc/tn-assistant/gateway/ca.pem
# TN_ZALO_GATEWAY_CLIENT_CERT_FILE=/etc/tn-assistant/gateway/client.pem
# TN_ZALO_GATEWAY_CLIENT_KEY_FILE=/etc/tn-assistant/gateway/client.key

# Optional cloud speech providers. Do not set the enable/provider selectors
# until the provider account has been secured and the key has been tested.
# Deepgram's new-account credits are one-time, not a recurring monthly quota.
# Turn off Deepgram auto-reload in its console before enabling this provider.
# TN_ASR_PROVIDER=deepgram
# TN_DEEPGRAM_ENABLED=false
# TN_DEEPGRAM_API_KEY=
# TN_DEEPGRAM_MONTHLY_AUDIO_MINUTES=120

# Azure Speech F0 provides a recurring free tier. The app caps TTS at 450,000
# characters per UTC month and uses vi-VN-HoaiMyNeural (female Vietnamese).
# TN_TTS_PROVIDER=azure
# TN_AZURE_SPEECH_REGION=southeastasia
# TN_AZURE_SPEECH_KEY=

# Explicit TTS-only exception: use the original app's configured upstream TTS.
# This reintroduces an original-service dependency; no free/commercial quota
# is inferred. Keep credentials private and configure only the tts provider.
# TN_TTS_PROVIDER=original
# TN_TTS_API_KEY=
# TN_TTS_SECRET=
