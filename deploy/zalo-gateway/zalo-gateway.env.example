# Install as /etc/tn-assistant/zalo-gateway.env with owner root and mode 0640.
TN_ZALO_GATEWAY_LISTEN=0.0.0.0:443
TN_ZALO_GATEWAY_TLS_CERT_FILE=/etc/tn-assistant/gateway/server.pem
TN_ZALO_GATEWAY_TLS_KEY_FILE=/etc/tn-assistant/gateway/server.key
TN_ZALO_GATEWAY_CLIENT_CA_FILE=/etc/tn-assistant/gateway/client-ca.pem
# Comma-separated SHA-256 fingerprints (hex); overlap old/new certificates only during rotation.
TN_ZALO_GATEWAY_ALLOWED_CLIENT_CERT_SHA256=REPLACE_WITH_BACKEND_CLIENT_CERT_SHA256
TN_ZALO_GATEWAY_MAX_TUNNELS=32
TN_ZALO_GATEWAY_CONNECT_TIMEOUT=5s
TN_ZALO_GATEWAY_IDLE_TIMEOUT=30s
TN_ZALO_GATEWAY_MAX_TUNNEL_DURATION=2m
